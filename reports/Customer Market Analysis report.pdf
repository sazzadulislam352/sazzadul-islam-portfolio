(SELECT customer_id,) Tj
T* (  NTILE\(4\) OVER \(ORDER BY recency_days\) AS r_score,) Tj
T* (  NTILE\(4\) OVER \(ORDER BY frequency\) AS f_score,) Tj
T* (  NTILE\(4\) OVER \(ORDER BY monetary DESC\) AS m_score) Tj
T* (FROM customer_agg;) Tj
